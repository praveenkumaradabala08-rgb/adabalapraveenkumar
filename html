<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Simple Car Game</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; font-family: Arial, sans-serif; }
    body {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
      background: #1e293b;
      color: #fff;
    }
    #hud {
      width: 360px;
      display: flex;
      justify-content: space-between;
      margin-bottom: 10px;
      font-size: 18px;
      font-weight: bold;
    }
    #game {
      position: relative;
      width: 360px;
      height: 540px;
      background: #334155;
      border: 4px solid #94a3b8;
      overflow: hidden;
      border-radius: 8px;
    }
    .line {
      position: absolute;
      width: 8px;
      height: 70px;
      background: #f8fafc;
      left: 176px;
    }
    #player {
      position: absolute;
      width: 46px;
      height: 80px;
      background: #ef4444;
      border-radius: 8px;
      bottom: 20px;
      left: 157px;
      box-shadow: inset 0 -10px 0 #991b1b;
    }
    .enemy {
      position: absolute;
      width: 46px;
      height: 80px;
      background: #38bdf8;
      border-radius: 8px;
      box-shadow: inset 0 -10px 0 #0369a1;
    }
    #overlay {
      position: absolute;
      inset: 0;
      background: rgba(15, 23, 42, 0.85);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 14px;
      text-align: center;
      padding: 20px;
    }
    button {
      padding: 10px 22px;
      font-size: 16px;
      font-weight: bold;
      border: none;
      border-radius: 6px;
      background: #22c55e;
      color: #052e16;
      cursor: pointer;
    }
    button:hover { background: #16a34a; }
  </style>
</head>
<body>
  <div id="hud">
    <span>Score: <b id="score">0</b></span>
    <span>Use ⬅️ ➡️ or A / D</span>
  </div>
  <div id="game">
    <div id="player"></div>
    <div id="overlay">
      <h2 id="title">Highway Dodge</h2>
      <p id="msg">Avoid incoming cars and survive as long as you can.</p>
      <button id="startBtn">Start Game</button>
    </div>
  </div>

  <script>
    const game = document.getElementById("game");
    const player = document.getElementById("player");
    const scoreEl = document.getElementById("score");
    const overlay = document.getElementById("overlay");
    const titleEl = document.getElementById("title");
    const msgEl = document.getElementById("msg");
    const startBtn = document.getElementById("startBtn");
